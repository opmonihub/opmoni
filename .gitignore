# Root — opmoni (backend/ e frontend/ têm .gitignore próprios; isto é rede de segurança + raiz)

# Env local (cobre raiz e qualquer pacote sem regra própria)
.env
.env.*
!.env.example
# Arquivo de segredo com sufixo (opmoni.prod.env, secrets.env): `.env`/`.env.*`
# acima NÃO pega a forma `nome.env`, e é exatamente essa que o AGENTS.md manda
# criar com APP_KEY e DB_PASSWORD antes do deploy.
*.env

# Deps / build — bate em qualquer nível (inclui futuros pacotes)
node_modules/
vendor/
.nuxt/
.output/
.data/
.nitro/
.cache/
dist/
public/build
public/hot

# Logs / SO / IDE
*.log
logs/
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
.history
.fleet

# Docker — override local nunca vai ao git
docker-compose.override.yml

# Cache de teste PHP
.phpunit.result.cache
.phpunit.cache/
.phpactor.json

# Material de referência local: ~1GB, só-leitura, contém .git aninhado + node_modules
.ref/

# Worktrees locais (isolamento SDD)
.worktrees/
.workitrees/
.workittrees/

# Ledger e artefatos de execução do subagent-driven-development (por plano)
.superpowers/

# Ferramentas locais (não versionar: config da máquina + licença de skill copiada)
.openchamber/
.devin/
.impeccable/
.codex/
.cursor/
.nova/

# Skills e droids de agente: instalados por ferramenta em cada máquina, não
# versionados. Sem barra inicial para pegar também `backend/.agents/`.
.agents/
.factory/
backend/.claude/skills/

# Certificados A1 de dev (conteúdo criptografado — nunca versionar)
backend/storage/app/private/certificates/

# Chave/certificado solto em qualquer lugar do repo. O disco `private` do
# Laravel já se autoprotege (backend/storage/app/private/.gitignore = `*`), mas
# o que o dev baixa para testar upload de A1 ou mTLS do SERPRO nem sempre cai
# lá dentro. PFX/P12 é o formato de procuração eletrônica: conteúdo
# criptografado não quer dizer inofensivo no git.
*.pfx
*.p12
*.pem
*.key
# .crt/.cer NÃO entram aqui de propósito: certificado é público por definição e
# CA bundle legítimo é comum no repo. Quem vaza chave vaza em .key/.pem.

# SQLite acidental (testes usam :memory:; nunca commitar arquivo)
*.sqlite
database/database.sqlite
/backend/opmoni

# Pacotes de extensão baixados localmente
/*.vsix
