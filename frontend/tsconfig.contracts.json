{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "typeRoots": [
      "./node_modules/.pnpm/node_modules/@types"
    ],
    "paths": {
      "~/*": [
        "./app/*"
      ]
    }
  },
  "include": [
    "tests/adminContracts.test.ts",
    "tests/contracts/admin.ts",
    "tests/contracts/officeErpCommercial.ts"
  ]
}
