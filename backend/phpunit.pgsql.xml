<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/Integration/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <ini name="memory_limit" value="768M"/>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="redis" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="opmoni_test" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="redis" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
        <env name="DB_HOST" value="postgres" force="true"/>
        <env name="DB_USERNAME" value="opmoni" force="true"/>
        <env name="DB_PASSWORD" value="opmoni" force="true"/>
        <env name="REDIS_DB" value="13" force="true"/>
        <env name="REDIS_CACHE_DB" value="14" force="true"/>
        <env name="REDIS_SESSION_DB" value="15" force="true"/>
        <env name="REDIS_PREFIX" value="opmoni-access-test-" force="true"/>
        <env name="CACHE_PREFIX" value="opmoni-access-test-cache-" force="true"/>
        <env name="SESSION_CONNECTION" value="sessions" force="true"/>
        <env name="SESSION_STORE" value="sessions" force="true"/>
        <env name="FRONTEND_INGRESS_KEY" value="integration-test-only-key" force="true"/>
        <env name="FRONTEND_ORIGIN" value="http://localhost:3000" force="true"/>
        <env name="ERP_REGISTRATION_ENABLED" value="true" force="true"/>
        <env name="HASH_DRIVER" value="argon2id" force="true"/>
        <env name="ARGON_MEMORY" value="65536" force="true"/>
        <env name="ARGON_TIME" value="2" force="true"/>
        <env name="ARGON_THREADS" value="1" force="true"/>
    </php>
</phpunit>
