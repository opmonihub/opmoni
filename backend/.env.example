# Laravel host development. Compose overrides service hosts and access settings.
APP_NAME=Opmoni
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Match the browser origin and frontend/.env NUXT_INGRESS_KEY.
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_INGRESS_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=opmoni
DB_USERNAME=opmoni
DB_PASSWORD=opmoni

SESSION_DRIVER=redis
SESSION_LIFETIME=720
SESSION_CONNECTION=sessions
SESSION_STORE=sessions
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=420

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ERP commercial access (company plans/subscriptions; separate from office billing)
ERP_REGISTRATION_ENABLED=false
ERP_OFFICE_TRIAL_ENABLED=false
ERP_OPERATING_WRITES_ENABLED=false

# SERPRO mTLS: PHP OpenSSL + cURL with Guzzle P12 support are required.
# Diagnostics discard tokens; operational requests retain SERPRO_TIMEOUT=25.
SERPRO_AUTH_URL=https://autenticacao.sapi.serpro.gov.br/authenticate
SERPRO_AUTH_TRUSTED_HOSTS=autenticacao.sapi.serpro.gov.br
SERPRO_DIAGNOSTIC_CONNECT_TIMEOUT=3
SERPRO_DIAGNOSTIC_TIMEOUT=8
SERPRO_TIMEOUT=25
# SERPRO_TEMP_DIR=/absolute/path/to/backend/storage/app/private/serpro-tmp
# Proxy: access 10s, diagnostic/certificate writes 15s; session ownership 30s.
# Certificate <=2MiB, multipart body <=4MiB; HTTP transport POST with _method=PUT.
