APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Mesma origem do front: nginx serve a UI e a API (docker/nginx/dev.conf).
# Produção sobrescreve para https://app.inovaicontabil.com.br.
APP_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=opmoni
DB_USERNAME=opmoni
DB_PASSWORD=opmoni
SESSION_LIFETIME=120
# Em dev fica desligado. Produção NÃO lê este arquivo: quem liga é o
# SESSION_ENCRYPT="true" em docker-stack.prod.yml (serviços backend e queue).
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
# Host-only é o default (SESSION_DOMAIN vazio). Produção liga o secure:
# o Traefik termina TLS e o nginx repassa o X-Forwarded-Proto (confia em
# proxies em bootstrap/app.php), então o cookie só volta por HTTPS.
# SESSION_SECURE_COOKIE=true

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,[::1],[::1]:*

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
# Redis com senha em prod (compose local não usa)
REDIS_PASSWORD=null
REDIS_PORT=6379

# Provedor CNPJ pago (hoje usa tier público com cache + rate 3/min)
# CNPJ_WS_TOKEN=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Integra Contador (SERPRO) — URLs separadas para que uma chamada de
# demonstração seja distinguível de uma chamada real.
# SERPRO_AUTH_URL=https://autenticacao.sapi.serpro.gov.br/authenticate
# SERPRO_GATEWAY_URL=https://gateway.apiserpro.serpro.gov.br/integra-contador/v1
# SERPRO_TRIAL_GATEWAY_URL=https://gateway.apiserpro.serpro.gov.br/integra-contador-trial/v1
# SERPRO_TIMEOUT=25

# Bearer público do ambiente de demonstração, só para teste de contrato.
# SERPRO_TRIAL_TOKEN=
