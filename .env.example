# Docker Compose interpolation only; service variables are explicit in docker-compose.yml.
# Private Nuxt-to-Laravel ingress key. Generate with: openssl rand -hex 32
FRONTEND_INGRESS_KEY=

# Published host ports (container ports remain fixed).
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Backend SERPRO variables live in backend/.env (no credentials in this file).
# Diagnostic TLS peer verification is mandatory; HTTPS auth host is allowlisted.
# Diagnostic connect/total=3s/8s; Nuxt diagnostic/certificate writes=15s;
# ordinary access=10s, operational fiscal/export/bulk retains its existing budget.
# Session lock=30s; applicable certificate/body limits=2MiB/4MiB (413).
